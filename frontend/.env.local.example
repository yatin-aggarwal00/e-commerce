# Browser-facing API base (used by client components). Must be reachable from
# the user's browser.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Server-side API base (used by Server Components during SSR/ISR). Inside
# docker-compose this is the internal service URL; locally it matches the one
# above.
API_URL_INTERNAL=http://localhost:8000/api/v1

# Public site URL, used for canonical links, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
