# Copy to .env and fill in. NEVER commit real secrets.

ENVIRONMENT=development
DEBUG=true

# Database (docker-compose service name is "db")
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/furniture

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000

# Orders / inventory integrity
# Pending orders left unpaid longer than this are cancelled by a scheduled job,
# which releases the stock they reserved at checkout.
ORDER_PENDING_TTL_MINUTES=60
# How often the in-process expiry scheduler runs.
ORDER_EXPIRY_INTERVAL_MINUTES=5
# Set false to disable the in-process scheduler (e.g. when a dedicated worker
# owns the schedule). The on-demand admin trigger still works either way.
SCHEDULER_ENABLED=true

# Payments — leave STRIPE_SECRET_KEY empty to use the built-in fake provider.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
# Publishable key is served to the storefront via GET /payments/config.
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
CURRENCY=usd

# Object storage for product images.
#   local -> writes to MEDIA_ROOT, served at /media (dev default)
#   s3    -> uploads to an S3-compatible bucket, served via S3_PUBLIC_BASE_URL
STORAGE_BACKEND=local
MEDIA_ROOT=media
# Absolute base used to build local image URLs (match your API's public host).
PUBLIC_MEDIA_BASE_URL=http://localhost:8000
# S3 / CDN (required when STORAGE_BACKEND=s3)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Email — "console" prints to logs; "smtp" sends real mail.
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@furniture.example

# Frontend URL (used in emails / links)
FRONTEND_URL=http://localhost:3000

# Observability
SENTRY_DSN=
